import matplotlib.pyplot as plt
import pandas as pd 
import seaborn as sns 

#load dataset 
df = pd.read_csv("House_Price.csv")
# 1. Strongest Linear Correlations with SalePrice
plt.figure(figsize=(8, 6))
numeric_df = df.select_dtypes(include=['int64', 'float64'])
top_corr = numeric_df.corr()['SalePrice'].sort_values(ascending=False)[1:10]

sns.barplot(x=top_corr.values, y=top_corr.index, palette='Blues_r')
plt.title('Top 9 Features Correlated with Sale Price')
plt.xlabel('Correlation Coefficient')
plt.show()

#Shows the strongest positive relationship with SalePrice. 
#Higher quality ratings lead to exponential price increases.


# 2. Overall Quality vs. Sale Price
plt.figure(figsize=(8, 5))
sns.boxplot(x='OverallQual', y='SalePrice', data=df)
plt.title('House Price Distribution by Overall Quality')
plt.xlabel('Overall Quality (1-10)')
plt.ylabel('Sale Price ($)')
plt.show()



# 3. Above-Ground Living Area vs. Sale Price
plt.figure(figsize=(8, 5))
sns.scatterplot(x='GrLivArea', y='SalePrice', data=df, alpha=0.6)
plt.title('Living Area (GrLivArea) vs Sale Price')
plt.xlabel('Above Ground Living Area (sq ft)')
plt.ylabel('Sale Price ($)')
plt.show()

#Exhibits a direct linear trend where larger square footage strongly increases valuation.


# 4. Average Sale Price by Neighborhood
plt.figure(figsize=(10, 6))
neighborhood_prices = df.groupby('Neighborhood')['SalePrice'].median().sort_values(ascending=False)
sns.barplot(x=neighborhood_prices.values, y=neighborhood_prices.index, palette='viridis')
plt.title('Median Sale Price by Neighborhood')
plt.xlabel('Median Sale Price ($)')
plt.ylabel('Neighborhood')
plt.show()
#Location creates significant price variance (e.g., premium neighborhoods like NridgHt or NoRidge command higher medians).  
